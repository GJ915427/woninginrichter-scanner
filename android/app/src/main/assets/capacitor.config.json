{
	"appId": "com.woninginrichter.scanner",
	"appName": "Woninginrichter 3D Scanner",
	"webDir": "www",
	"server": {
		"androidScheme": "https",
		"cleartext": true,
		"allowNavigation": [
			"localhost",
			"127.0.0.1",
			"*.woninginrichter.nl"
		]
	},
	"android": {
		"allowMixedContent": true,
		"captureInput": true,
		"webContentsDebuggingEnabled": true
	},
	"plugins": {
		"UltraWideCamera": {
			"enable100HzIMU": true,
			"defaultZoomRatio": 0.5,
			"lockExposureAndFocus": true
		}
	}
}
